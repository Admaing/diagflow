{
  "name": "diagflow-ts-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent SDK based monitoring/troubleshooting agent for DiagFlow",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "investigate": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "prom-mcp": "tsx src/mcp/prom-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "typebox": "^1.3.27",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
