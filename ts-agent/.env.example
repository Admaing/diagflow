# ── LLM ──────────────────────────────────────────────────────────────
# Pi resolves the provider/model below. DeepSeek is the default.
DEEPSEEK_API_KEY=
# PI_MODEL_PROVIDER=deepseek
# PI_MODEL_ID=deepseek-flash
# PI_THINKING_LEVEL=medium
# Custom provider (e.g. modelverse) configured in ~/.pi/agent/models.json:
# PI_MODEL_PROVIDER=modelverse
# PI_MODEL_ID=deepseek-v4.1-flash
# TS_AGENT_LLM_API_KEY=

# ── Cluster access (read-only MCP gateway) ───────────────────────────
DIAGFLOW_MCP_BASE_URL=http://127.0.0.1:8090/mcp
DIAGFLOW_MCP_TOKEN=
# Expose ssh_exec to the model only when explicitly enabled.
TS_AGENT_ALLOW_SSH_EXEC=0
# Max time to wait for MCP servers to register their tools.
TS_AGENT_MCP_STARTUP_WAIT_MS=15000

# ── Monitoring ───────────────────────────────────────────────────────
PROMETHEUS_URL=http://127.0.0.1:9090
ALERTMANAGER_URL=http://127.0.0.1:9093
# PROMETHEUS_BASIC_AUTH=user:pass
# PROMETHEUS_BEARER_TOKEN=

# ── Service ──────────────────────────────────────────────────────────
TS_AGENT_PORT=8099
# TS_AGENT_AUTH_TOKEN=
TS_AGENT_REQUEST_TIMEOUT_MS=240000
TS_AGENT_STAGE_TIMEOUT_MS=120000
TS_AGENT_MAX_CONCURRENT=2
TS_AGENT_LANGUAGE=zh-CN
# Log model output and session messages to stderr.
TS_AGENT_DEBUG=0

# ── Paths (optional) ─────────────────────────────────────────────────
# TS_AGENT_AGENT_DIR=./.pi-agent
# TS_AGENT_WORKSPACE=./.agent-workspace
